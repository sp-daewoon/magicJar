{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "TodoWrite",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git config user.*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin hotfix/*)",
      "Bash(git push origin hotfix/*)",

      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps)",
      "Bash(docker logs:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status)",
      "Bash(gh api repos/*/pulls/*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",

      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(diff:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(cat:*)",
      "Bash(unzip:*)",
      "Bash(true)",
      "Bash(false)",

      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:spring.io)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:apiportal.koreainvestment.com)",
      "WebFetch(domain:opendart.fss.or.kr)",
      "WebFetch(domain:openapivts.koreainvestment.com)"
    ],

    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(git push origin main)",
      "Bash(npm publish:*)",
      "Bash(gh release create:*)"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r ~:*)",
      "Bash(rm -r /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete main)",
      "Bash(gh repo delete:*)",
      "Bash(gh auth logout:*)",
      "WebFetch(domain:openapi.koreainvestment.com)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/autonomy-gate.sh",
            "if": "Bash(gh pr merge:*)",
            "timeout": 5,
            "statusMessage": "autonomy-gate 검사…"
          }
        ]
      }
    ]
  }
}
