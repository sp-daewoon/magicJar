# magicJar 환경변수 템플릿. 실제 값은 `.env`에 복사해 채워넣을 것 (gitignore 대상).

# ─── 실행 프로파일 / 모드 ───
SPRING_PROFILES_ACTIVE=dev
MAGICJAR_MODE=MOCK
MAGICJAR_ALLOW_REAL=false

# ─── Mock 발행기 (실 키 부재·offline 데모에서만 ON) ───
# 실 KIS 키 채워지면 false 유지. 데모·offline 환경에서만 명시 활성.
MAGICJAR_MARKET_MOCKTICK_ENABLED=false
MAGICJAR_MARKET_MOCKNEWS_ENABLED=false

# ─── 한국투자증권 OpenAPI (ADR 0003) ───
# 시스템 키 (prod) — 데이터 조회. 모의 키 (vps) — 주문.
MAGICJAR_KIS_APP_KEY=
MAGICJAR_KIS_APP_SECRET=
MAGICJAR_KIS_VPS_APP_KEY=
MAGICJAR_KIS_VPS_APP_SECRET=
MAGICJAR_KIS_BASE_URL_PROD=https://openapi.koreainvestment.com:9443
MAGICJAR_KIS_BASE_URL_VPS=https://openapivts.koreainvestment.com:29443
MAGICJAR_KIS_WS_URL=ws://ops.koreainvestment.com:21000

# 계좌 정보
MAGICJAR_KIS_ACCOUNT_CANO=
MAGICJAR_KIS_ACCOUNT_PRDT=01
MAGICJAR_KIS_HTS_ID=

# Redis 분산 single-flight 활성화 (multi-JVM single-flight, ADR 0007/0029)
MAGICJAR_KIS_REDIS_TOKEN_ENABLED=false

# 토큰 운영 파라미터 (default 그대로 유지 권장)
MAGICJAR_KIS_TOKEN_REFRESH_MARGIN=3600
MAGICJAR_KIS_TOKEN_LOCK_WAIT=10
MAGICJAR_KIS_TOKEN_LOCK_LEASE=15
MAGICJAR_KIS_TOKEN_REDIS_TTL=25

# ─── 시크릿 마스터 키 (AES-256-GCM) ───
# 사용자별 KIS 키를 DB에 저장할 때 사용. 32바이트 base64.
# 운영 진입 시 secret manager로 이전.
MAGICJAR_SECRET_MASTER_KEY=

# ─── LLM (ADR 0026 — AI 옵션 보조) ───
# 사용자 트리거 한정. default false — 비용 0 mock fallback.
# 활성화: ANTHROPIC_API_KEY 설정 + MAGICJAR_AI_ENABLED=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAGICJAR_AI_ENABLED=false
MAGICJAR_AI_PROVIDER=anthropic
MAGICJAR_AI_MODEL=claude-sonnet-4-5
# auto: 키 없으면 자동 mock (default) · mock: 강제 mock · real: 키 필수 (controller 503)
MAGICJAR_AI_MOCK_MODE=auto

# ─── PostgreSQL (ADR 0006) ───
# IDE bootRun 시 localhost 사용. docker compose 내부에서는 자동으로 postgres 호스트명 사용.
DB_URL=jdbc:postgresql://localhost:5432/magicjar
DB_USER=magicjar
DB_PASSWORD=magicjar
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/magicjar
SPRING_DATASOURCE_USERNAME=magicjar
SPRING_DATASOURCE_PASSWORD=magicjar

# ─── Redis (ADR 0029 — 사용자 차트 캐시 + KIS 토큰 store) ───
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ─── Kafka (ADR 0007) ───
# IDE bootRun: localhost:9092 (compose infra 모드의 EXTERNAL listener)
# 컨테이너 간: kafka:9092 (compose 자동 주입)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=magicjar-local

# ─── 전자공시 / 뉴스 (api 모듈에서 사용) ───
# DART OpenAPI (https://opendart.fss.or.kr)
OPENDART_API_KEY=
# 네이버 금융 뉴스 RSS
NAVER_NEWS_RSS_URL=
# Yahoo Finance — api 모듈 cold-start backfill (1m/D1, KOSPI .KS / KOSDAQ .KQ)
# JVM RestClient + Jackson 직접 호출. ADR 0019 (1m 단일 + Yahoo 하이브리드) 정합.

# ─── 프론트엔드 (개발 시) ───
# API base URL을 vite dev에서 override할 때 사용
VITE_API_BASE_URL=http://localhost:8080
