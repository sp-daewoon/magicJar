# 운영 default(파라미터 튜닝)는 application.yml. 이 파일은 사용자가 직접 채우는 시크릿/환경 좌표만.

# === 실행 프로파일 (master §7) ===
SPRING_PROFILES_ACTIVE=dev,real-kis     # default — mock 부팅 path 폐기
MAGICJAR_MODE=MOCK                      # MOCK | PAPER | REAL
MAGICJAR_ALLOW_REAL=false               # REAL 진입 이중 게이트 (true + MAGICJAR_MODE=REAL)

# 초과 시 OrderRouter REJECTED + audit(reason=CANARY_QTY_CAP / CANARY_NOTIONAL_CAP / CANARY_DAILY_ORDER_CAP).
MAGICJAR_CANARY_MAX_ORDER_QTY=0             # 주문 1건 수량 절대 상한 (0=비활성)
MAGICJAR_CANARY_MAX_ORDER_NOTIONAL_KRW=0    # 주문 1건 notional(qty×price) 원화 절대 상한 (0=비활성)
MAGICJAR_CANARY_MAX_ORDERS_PER_DAY=0        # 당일(KST) REAL 주문 횟수 전역 상한 (0=비활성, order_request DB count)

# MAGICJAR_ORDER_ACK_RESYNC_STALE_THRESHOLD_SECONDS=180       # P2-4 ACK/PARTIALLY_FILLED 정체 임계(초) — 초과 시 KIS 당일체결 대조
# MAGICJAR_ORDER_DAY_ORDER_EXPIRY_ENABLED=true                # 장마감 만료 day-order ACK/REQUESTED 잔류 정리 worker
# MAGICJAR_ORDER_DAY_ORDER_EXPIRY_MARKET_CLOSE_GRACE_MINUTES=20 # 장마감(15:30) 후 당일 주문 만료 대조를 시작할 grace(분)
# === ADR 0115 §2-P2 R1 — 체결-원장 무결성 토글 (운영 default 는 application.yml · 아래는 rollback 우회용) ===
# MAGICJAR_POSITION_LEDGER_REBUILD_ENABLED=true               # strategy_position 을 order_execution 진실원 파생 재계산(대안 B). false→증분+drift 회귀
# MAGICJAR_ORDER_CANCELLED_FILL_RECONCILE_ENABLED=true        # terminal(CANCELLED) 주문 KIS 실체결 누락 흡수(G5 취소-체결 race). false→현행 terminal skip
# === ADR 0136 — KIS 실잔고 ↔ strategy_position self-heal (broker 진실원 교차검증 자동 정정 워커) ===
# MAGICJAR_RECONCILE_KIS_LEDGER_SELF_HEAL_ENABLED=false       # 장중 주기 KIS inquire-balance ↔ ledger 대조·drift 시 KIS 권위 rebuild 자동 정정. default false(라이브 검증 후 활성)
# MAGICJAR_RECONCILE_KIS_LEDGER_SELF_HEAL_CRON=0 */10 9-15 * * MON-FRI  # 장중 10분(reconcile 5분과 다른 위상 — KIS 호출 분산)
# MAGICJAR_RECONCILE_KIS_LEDGER_SELF_HEAL_DRIFT_THRESHOLD=1   # abs(kisQty - ledgerSum) ≥ 임계일 때만 정정 시도
# MAGICJAR_DEPLOY_DRAIN_INFLIGHT_CHECK_ENABLED=true           # consumer 재배포 전 in-flight 주문 drain 가드(build-and-deploy). false→가드 off
# SKIP_DRAIN_CHECK=1                                          # (1회성) drain 가드 명시 우회 — in-flight 있어도 강제 재배포

# MAGICJAR_KIS_VPS_APP_SECRET=
MAGICJAR_KIS_BASE_URL_PROD=https://openapi.koreainvestment.com:9443
MAGICJAR_KIS_BASE_URL_VPS=https://openapivts.koreainvestment.com:29443
# https://raw.githubusercontent.com/koreainvestment/open-trading-api/main/kis_devlp.yaml
MAGICJAR_KIS_WS_URL_PROD=ws://ops.koreainvestment.com:21000
MAGICJAR_KIS_WS_URL_VPS=ws://ops.koreainvestment.com:31000
MAGICJAR_KIS_WS_USER_ID=                # KIS WS approval_key 발급용 사용자 ID (온보딩 후 자동 설정)
# false 시 단일 :global 버킷(capacity 10) 회귀 (Phase 1 안전 최소 — rollback).
MAGICJAR_KIS_PRIORITY_BUCKETS_ENABLED=true
MAGICJAR_KIS_BUCKET_USER=4              # USER_PATH 1차 (주문·현재가·차트·잔고)
MAGICJAR_KIS_BUCKET_REALTIME_MARKET=2   # ACTIVE 전략 degraded 시세 보강
MAGICJAR_KIS_BUCKET_SHARED=2            # INGESTION 1차 (watchlist·approval) + USER_PATH fallback
MAGICJAR_KIS_BUCKET_BG=2                # BACKFILL·INGESTION_LOW 1차 (캔들 backfill·지수/섹터 cron)
# KIS rate limit 알람 차등화 (2026-06-10) — 5분 윈도 EGW00201 건수 < 임계 → INFO(알림센터만), ≥ 임계 → WARN(알람).
MAGICJAR_KIS_RATE_LIMITER_TPS_EXCEEDED_WARN_THRESHOLD=5
# Yahoo Finance cold-start (ADR 0048 §2-7 + external-api-policy.md §3)
MAGICJAR_YAHOO_BASE_URL=https://query1.finance.yahoo.com
MAGICJAR_YAHOO_TIMEOUT=10
MAGICJAR_YAHOO_RETRY_WAIT=60
# MarketSession (ADR 0048 §2-5 — 1차 시간 기반 stub. 공휴일 처리는 T-MS1)
MAGICJAR_SESSION_CHECK_INTERVAL=60

# 보통주 ~2,517 종목의 10년 일봉을 J(KRX 본시장) 단일 채널로 멱등 적재. enabled=false(default)면 가동 0.
MAGICJAR_MARKET_DAILY_BACKFILL_ENABLED=false          # 시동 게이트 (default false — true 여야 가동)
MAGICJAR_MARKET_DAILY_BACKFILL_HISTORY_YEARS=10       # 이력 깊이 (결재 ② LOCK 10년)
MAGICJAR_MARKET_DAILY_BACKFILL_NIGHTLY_CALL_CAP=6000  # 1회 실행당 KIS 콜 상한 (초과분 다음 실행 이연)
# 동시성 보강 (amend §9-D) — coroutine Semaphore throughput shaping. KIS hard ceiling(초당 10건)은 별도 유효.
MAGICJAR_MARKET_DAILY_BACKFILL_CONCURRENCY=10         # 동시 처리 종목 수 (Semaphore permits, 1=직렬, 상한 32)
MAGICJAR_MARKET_DAILY_BACKFILL_LAUNCH_DELAY_MS=100    # 종목 launch 간 지연(ms) — burst 분산
#   POST /admin/market-daily-backfill/run?mode=MIGRATE  (1m·5m 는 화이트리스트 LOCK 으로 절대 보존)

# today 1봉만 전진(과거 gap 은 R-BF 소관). J 단일 채널(amend §9-B).
MAGICJAR_MARKET_DAILY_SNAPSHOT_ENABLED=true             # kill-switch (default true — 운영 점검 시 false)
MAGICJAR_MARKET_DAILY_SNAPSHOT_CRON=0 5 20 * * *        # 저녁 발사 cron (zone=Asia/Seoul 고정). 비거래일 자동 skip
MAGICJAR_MARKET_DAILY_SNAPSHOT_PRE_OPEN_CRON=0 5 8 * * * # 장전 직전 영업일 1d 재확정 cron. 비거래일 자동 skip
MAGICJAR_MARKET_DAILY_SNAPSHOT_CHUNK_SPACING_MS=120     # chunk(30종목/콜) 간 지연(ms) — burst 분산 (상한 5초)

# === 발굴 → MOCK 페이퍼 트레이딩 (ADR 0122 — 발굴 후보 실시간 모의 검증) ===
# 발굴 setup 을 사용자 opt-in 으로 origin=PAPER_DISCOVERY 전략으로 승격 → 기존 signal→risk→order 경로(MOCK 강제).
# 가상 자본 격리(실 KIS 잔고 미오염) + 페이퍼 RiskConfig 파생 키 `<userId>:paper` 별 행. 실거래 결정권 0.
MAGICJAR_DAYTRADE_PAPER_ENABLED=true                    # 승격 API 활성 게이트 (false=503 — rollback)
MAGICJAR_DAYTRADE_PAPER_DEFAULT_CAPITAL_KRW=10000000    # 가상 자본 초기 default(원, spec §8-2 결재 = 1천만)
MAGICJAR_DAYTRADE_PAPER_MAX_INSTANCES=10                # 사용자당 활성 페이퍼 전략 상한 (WS 슬롯 보호 · ADR 0122 §5)

# === autopilot 일일 universe 자동 재생성 (ADR 0131) ===
# 발굴 scorecard 오늘 snapshot(08:30) → deduped TOP N(code별 max score) → owner=AUTOPILOT codes 갱신(08:35).
# codes = BUY 평가 대상일 뿐 청산 대상 아님 — universe 밖 보유 lot 은 hold-until-exit(강제 청산 0). USER/SYSTEM codes touch 0.
MAGICJAR_AUTOPILOT_UNIVERSE_REFRESH_ENABLED=false        # 게이트 (default false — 최고위험 자본경로). off=08:35 worker no-op=고정 universe 유지
MAGICJAR_AUTOPILOT_UNIVERSE_REFRESH_CRON=0 35 8 * * *    # 08:35 KST cron (snapshot 08:30 직후·개장 09:00 전). 거래일 게이트+1일1회 멱등
MAGICJAR_AUTOPILOT_UNIVERSE_REFRESH_SIZE=16             # deduped TOP N 종목 수 (1~40, 상한 40 = ADR 0124 WS slot 예산)

# === 시크릿 마스터 키 (AES-256-GCM, 32바이트 base64) ===
MAGICJAR_SECRET_MASTER_KEY=

# 매매 결정권 0 — 본 키들이 시그널 / 주문 흐름에 사용될 일은 절대 없습니다 (ADR 0023 정합).

# 1차 default — Anthropic Claude (claude-3-5-haiku-20241022)
ANTHROPIC_API_KEY=

# ★ adapter @Value 바인딩 키 = GEMINI_API_KEY (MAGICJAR_AI_GEMINI_API_KEY 아님 — 2026-06-09 정정)
GEMINI_API_KEY=

# ★ adapter @Value 바인딩 키 = OPENAI_API_KEY (MAGICJAR_AI_OPENAI_API_KEY 아님 — 2026-06-09 정정)
OPENAI_API_KEY=

#   비용 0 — CLI 는 토큰 카운트 미제공 → ai_comment_log 에 tokens 0 / cost 0 정직 기록.
MAGICJAR_AI_CLAUDE_CLI_BRIDGE_URL=
MAGICJAR_AI_CLAUDE_CLI_COMMAND=claude
MAGICJAR_AI_CLAUDE_CLI_TIMEOUT_SECONDS=300

MAGICJAR_AI_ENABLED=false
MAGICJAR_AI_PROVIDER=anthropic          # anthropic | gemini | openai | claude-cli (claude-cli 는 키 불요)
MAGICJAR_AI_MOCK_MODE=auto              # auto: 키 없으면 mock(claude-cli 는 키 불요라 제외) | mock: 강제 | real: 키 필수

# AI KillSwitch (ADR 0094 §4-4-B amend) — true 시 모든 AI 호출 즉시 차단 (운영자 긴급 비용 폭주 차단)
MAGICJAR_AI_KILLSWITCH=false

# 1일 1사용자 토큰 한도 (ADR 0026 §2-5 amend) — 초과 시 graceful refuse 한국어
MAGICJAR_AI_DAILY_TOKEN_LIMIT=1000

#   IDE bootRun 시에만 본 .env의 localhost 값 사용 (application.yml ${DB_URL:fallback} placeholder + Spring relaxed binding).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/magicjar
SPRING_DATASOURCE_USERNAME=magicjar
SPRING_DATASOURCE_PASSWORD=magicjar

# === Redis 7 (ADR 0029·0038) ===
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# IDE bootRun: localhost:9092 / 컨테이너 간: kafka:9092 (docker compose가 environment block으로 강제 override)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=magicjar-local

# http://localhost:8888 에서 모든 docker 컨테이너 로그 실시간 확인
DOZZLE_HOST_PORT=8888

# === 관측 스택 (docker-compose.observability.yml — 감사 §3-⑧) ===
# Alertmanager → Slack incoming webhook URL. 미설정 시 알림 미발송(blackhole) + :9093 UI 관측만.
# Prometheus alert rule의 severity(critical|warn)별 차등 라우팅은 docker/observability/alertmanager/alertmanager.yml.
ALERTMANAGER_SLACK_WEBHOOK=
ALERTMANAGER_HOST_PORT=9093

# frontend 컨테이너 호스트 포트 (docker-compose.yml — 기본 3000)
FRONTEND_HOST_PORT=3000

# === 종목 마스터 sync (T-IM1 — ADR 0017·0039) ===
MAGICJAR_INSTRUMENT_SYNC_AT_BOOT=false  # true: 부팅 직후 즉시 sync (dev 권장), false: cron만 (prd)
MAGICJAR_INSTRUMENT_KIS_DISABLED=false  # true: KIS fetch 차단 + 시드 fallback만 (test·CI 환경)
# KIS 종목 마스터 zip URL (KIS-first: kis-api-reference.md §6 + open-trading-api kis_kospi_code_mst.py)
MAGICJAR_KIS_KOSPI_MST_URL=https://new.real.download.dws.co.kr/common/master/kospi_code.mst.zip
MAGICJAR_KIS_KOSDAQ_MST_URL=https://new.real.download.dws.co.kr/common/master/kosdaq_code.mst.zip

# KrxMarketSessionResolver — market_calendar DB + KIS chk-holiday(CTCA0903R) 기반
MAGICJAR_MARKET_SESSION_ENFORCE=true    # true: KrxMarketSessionResolver | false: 시간 기반 stub
# raw 출처: https://github.com/koreainvestment/open-trading-api/blob/main/examples_llm/domestic_stock/chk_holiday/chk_holiday.py
MAGICJAR_MARKET_CALENDAR_SYNC_AT_BOOT=false  # true: 부팅 시 KIS sync 1회 (재기동 +1회 주의)
MAGICJAR_MARKET_CALENDAR_KIS_DISABLED=false  # true: KIS 호출 차단 (test·CI — 정적 시드만)
# DailyCloseFinalizer (ADR 0013 §3-6): 매 거래일 16:00 KST 1d candle DB 영속
MAGICJAR_DAILY_CLOSE_CRON=0 0 16 * * *
# TickFallbackEmitter (ADR 0014): T2 폴백 주기
MAGICJAR_TICK_FALLBACK_DELAY_MS=10000

# === 외부 API (api 모듈) ===
OPENDART_API_KEY=                       # DART 공시 (https://opendart.fss.or.kr) — T-NEWS Phase 1 (ADR 0075)
NAVER_NEWS_RSS_URL=                     # 네이버 금융 RSS (Phase 4 잔류)

# 미설정 시 NaverNewsAdapter graceful skip + log INFO (mock 합성 0 정합)
NAVER_OPEN_API_CLIENT_ID=              # 네이버 개발자 센터 발급 클라이언트 아이디
NAVER_OPEN_API_CLIENT_SECRET=          # 네이버 개발자 센터 발급 클라이언트 시크릿

# static 검증 한도
MAGICJAR_DSL_AST_DEPTH_LIMIT=32          # AST 최대 depth (default: 32)
MAGICJAR_DSL_NODE_COUNT_LIMIT=10000      # AST 최대 노드 수 (default: 10000)
MAGICJAR_DSL_INDICATOR_CALL_LIMIT=50     # 최대 지표 호출 수 (default: 50)
# runtime sandbox timeout
MAGICJAR_DSL_EVAL_TIMEOUT_MS=100        # 실시간 평가 timeout ms (default: 100)
MAGICJAR_DSL_BACKTEST_TIMEOUT_MS=1000   # 백테스트 평가 timeout ms (default: 1000)
MAGICJAR_DSL_CPU_BUDGET_MS=50           # CPU budget ms (default: 50)
# strategy-eval-pool (ADR 0047 §2-3)
MAGICJAR_DSL_EVAL_POOL_SIZE=4           # 고정 thread pool 크기 (default: 4)
MAGICJAR_DSL_EVAL_POOL_QUEUE=100        # 대기 큐 크기 (default: 100)

# === Frontend (Vite dev override) ===
VITE_API_BASE_URL=http://localhost:8080

# 전략 메뉴의 시나리오 리플레이에서 실행 가능. KIS/order 경로를 사용하지 않고 scenario_*에만 기록한다.
MAGICJAR_SCENARIO_REPLAY_MAX_CANDLES=5000
MAGICJAR_SCENARIO_REPLAY_MAX_EVENTS=20000
