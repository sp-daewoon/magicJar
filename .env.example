# magicJar 환경변수 템플릿. 실제 값은 .env에 복사해 채울 것 (gitignore 대상).
# 운영 default(파라미터 튜닝)는 application.yml. 이 파일은 사용자가 직접 채우는 시크릿/환경 좌표만.

# === 실행 프로파일 (master §7) ===
SPRING_PROFILES_ACTIVE=dev,real-kis     # default — mock 부팅 path 폐기
MAGICJAR_MODE=MOCK                      # MOCK | PAPER | REAL
MAGICJAR_ALLOW_REAL=false               # REAL 진입 이중 게이트 (true + MAGICJAR_MODE=REAL)

# === KIS OpenAPI (ADR 0003·0037·0038) ===
# DEPRECATED — 셋업 마법사(/api/onboarding/*)로 등록하세요 (ADR 0046).
# 아래 키는 환경변수 직접 주입 방식이며 PR-6 이후 사용 금지.
# MAGICJAR_KIS_APP_KEY=
# MAGICJAR_KIS_APP_SECRET=
# MAGICJAR_KIS_VPS_APP_KEY=
# MAGICJAR_KIS_VPS_APP_SECRET=
MAGICJAR_KIS_BASE_URL_PROD=https://openapi.koreainvestment.com:9443
MAGICJAR_KIS_BASE_URL_VPS=https://openapivts.koreainvestment.com:29443
# KIS WebSocket URL — ws:// (비암호화, SSL 없음)
# KIS-first 출처: kis_devlp.yaml ops="ws://ops.koreainvestment.com:21000"
# https://raw.githubusercontent.com/koreainvestment/open-trading-api/main/kis_devlp.yaml
MAGICJAR_KIS_WS_URL_PROD=ws://ops.koreainvestment.com:21000
MAGICJAR_KIS_WS_URL_VPS=ws://ops.koreainvestment.com:31000
MAGICJAR_KIS_WS_USER_ID=                # KIS WS approval_key 발급용 사용자 ID (온보딩 후 자동 설정)
MAGICJAR_KIS_ACCOUNT_CANO=
MAGICJAR_KIS_ACCOUNT_PRDT=01
MAGICJAR_KIS_HTS_ID=
# Yahoo Finance cold-start (ADR 0048 §2-7 + external-api-policy.md §3)
MAGICJAR_YAHOO_BASE_URL=https://query1.finance.yahoo.com
MAGICJAR_YAHOO_TIMEOUT=10
MAGICJAR_YAHOO_RETRY_WAIT=60
# MarketSession (ADR 0048 §2-5 — 1차 시간 기반 stub. 공휴일 처리는 T-MS1)
MAGICJAR_SESSION_CHECK_INTERVAL=60

# === 시크릿 마스터 키 (AES-256-GCM, 32바이트 base64) ===
MAGICJAR_SECRET_MASTER_KEY=

# === LLM (ADR 0026 — AI 옵션, 사용자 트리거만, 매매 결정권 0) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MAGICJAR_AI_ENABLED=false
MAGICJAR_AI_PROVIDER=anthropic
MAGICJAR_AI_MOCK_MODE=auto              # auto: 키 없으면 mock | mock: 강제 | real: 키 필수

# === PostgreSQL 16 (ADR 0006) ===
# NOTE: SPRING_DATASOURCE_URL·SPRING_REDIS_HOST·KAFKA_BOOTSTRAP 등 SPRING_* 변수는
#   docker compose 시 docker-compose.yml의 environment block이 자동 override (PR-12 — backlog §12).
#   IDE bootRun 시에만 본 .env의 localhost 값 사용 (application.yml ${DB_URL:fallback} placeholder + Spring relaxed binding).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/magicjar
SPRING_DATASOURCE_USERNAME=magicjar
SPRING_DATASOURCE_PASSWORD=magicjar

# === Redis 7 (ADR 0029·0038) ===
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# === Kafka 3.7 KRaft (ADR 0007) ===
# IDE bootRun: localhost:9092 / 컨테이너 간: kafka:9092 (docker compose가 environment block으로 강제 override)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=magicjar-local

# === Dozzle 로그 web UI (옵션) ===
# http://localhost:8888 에서 모든 docker 컨테이너 로그 실시간 확인
DOZZLE_HOST_PORT=8888

# === 종목 마스터 sync (T-IM1 — ADR 0017·0039) ===
MAGICJAR_INSTRUMENT_SYNC_AT_BOOT=false  # true: 부팅 직후 즉시 sync (dev 권장), false: cron만 (prd)
MAGICJAR_INSTRUMENT_KIS_DISABLED=false  # true: KIS fetch 차단 + 시드 fallback만 (test·CI 환경)
# KIS 종목 마스터 zip URL (KIS-first: kis-api-reference.md §6 + open-trading-api kis_kospi_code_mst.py)
MAGICJAR_KIS_KOSPI_MST_URL=https://new.real.download.dws.co.kr/common/master/kospi_code.mst.zip
MAGICJAR_KIS_KOSDAQ_MST_URL=https://new.real.download.dws.co.kr/common/master/kosdaq_code.mst.zip

# === Market Session + KRX 영업일 캘린더 (ADR 0013, PR-29a) ===
# KrxMarketSessionResolver — market_calendar DB + KIS chk-holiday(CTCA0903R) 기반
MAGICJAR_MARKET_SESSION_ENFORCE=true    # true: KrxMarketSessionResolver | false: 시간 기반 stub
# KIS chk-holiday(CTCA0903R) 동기화 옵션
# KIS 명시: "1일 1회 권장 (당사 원장서비스와 연관)" → sync-at-boot는 운영 환경 주의
# raw 출처: https://github.com/koreainvestment/open-trading-api/blob/main/examples_llm/domestic_stock/chk_holiday/chk_holiday.py
MAGICJAR_MARKET_CALENDAR_SYNC_AT_BOOT=false  # true: 부팅 시 KIS sync 1회 (재기동 +1회 주의)
MAGICJAR_MARKET_CALENDAR_KIS_DISABLED=false  # true: KIS 호출 차단 (test·CI — 정적 시드만)
# DailyCloseFinalizer (ADR 0013 §3-6): 매 거래일 16:00 KST 1d candle DB 영속
MAGICJAR_DAILY_CLOSE_CRON=0 0 16 * * *
# TickFallbackEmitter (ADR 0014): T2 폴백 주기
MAGICJAR_TICK_FALLBACK_DELAY_MS=10000

# === 외부 API (api 모듈) ===
OPENDART_API_KEY=                       # DART 공시 (https://opendart.fss.or.kr)
NAVER_NEWS_RSS_URL=                     # 네이버 금융 RSS

# === Strategy DSL Sandbox (ADR 0047 — backend-core LOCK, spec §7) ===
# static 검증 한도
MAGICJAR_DSL_AST_DEPTH_LIMIT=32          # AST 최대 depth (default: 32)
MAGICJAR_DSL_NODE_COUNT_LIMIT=10000      # AST 최대 노드 수 (default: 10000)
MAGICJAR_DSL_INDICATOR_CALL_LIMIT=50     # 최대 지표 호출 수 (default: 50)
# runtime sandbox timeout
MAGICJAR_DSL_EVAL_TIMEOUT_MS=100        # 실시간 평가 timeout ms (default: 100)
MAGICJAR_DSL_BACKTEST_TIMEOUT_MS=1000   # 백테스트 평가 timeout ms (default: 1000)
MAGICJAR_DSL_CPU_BUDGET_MS=50           # CPU budget ms (default: 50)
# strategy-eval-pool (ADR 0047 §2-3)
MAGICJAR_DSL_EVAL_POOL_SIZE=4           # 고정 thread pool 크기 (default: 4)
MAGICJAR_DSL_EVAL_POOL_QUEUE=100        # 대기 큐 크기 (default: 100)

# === Frontend (Vite dev override) ===
VITE_API_BASE_URL=http://localhost:8080
