# magicJar 환경변수 템플릿. 실제 값은 `.env`에 복사해 채워넣을 것 (gitignore 대상).
# Phase D-P4 갱신: Kafka·MinIO·pyworker·OPENDART·NAVER 추가.
# 2026-05-01 (ADR 0029): 데이터는 모두 실 KIS·외부 API 베이스. dev/prd 분리는 OrderSender만.

# ─── 실행 프로파일 / 모드 ───
SPRING_PROFILES_ACTIVE=mock
# MAGICJAR_MODE: MOCK(모의계좌 주문) | PAPER(페이퍼) | REAL(실계좌 주문)
# - 데이터(시세·뉴스·캔들)는 어떤 모드든 실 KIS·외부 API 사용
# - dev/staging은 MOCK, prd는 REAL + ALLOW_REAL=true (이중 게이트)
MAGICJAR_MODE=MOCK
MAGICJAR_ALLOW_REAL=false
MAGICJAR_HARNESS_ENABLED=true

# ─── Mock 발행기 (실 키 부재·offline 데모에서만 ON) ───
# 실 KIS 키 채워지면 false 유지. 데모·offline 환경에서만 명시 활성.
MAGICJAR_MARKET_MOCKTICK_ENABLED=false
MAGICJAR_MARKET_MOCKNEWS_ENABLED=false

# ─── 한국투자증권 OpenAPI (모의계좌) ───
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=

# ─── 한국투자증권 OpenAPI (실계좌) — MAGICJAR_MODE=REAL 시에만 사용 ───
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_CANO=
KIS_ACCOUNT_PRDT=01

# ─── LLM ───
# OpenAI (consumer-app Spring AI 통합)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic (NoOpAiClient 대체용 — 미설정 시 자동 비활성)
ANTHROPIC_API_KEY=

# ─── AI 분석 보조 (T16, ADR 0046) ───
# 사용자 트리거 한정. default false — 비용 0 mock fallback.
# 활성화: ANTHROPIC_API_KEY 설정 + MAGICJAR_AI_ENABLED=true
MAGICJAR_AI_ENABLED=false
MAGICJAR_AI_PROVIDER=anthropic
MAGICJAR_AI_MODEL=claude-sonnet-4-5
# auto: 키 없으면 자동 mock (default) · mock: 강제 mock · real: 키 필수 (controller 503으로 명시 실패)
MAGICJAR_AI_MOCK_MODE=auto

# ─── PostgreSQL ───
# IDE bootRun 시 localhost 사용. docker compose 내부에서는 자동으로 postgres 호스트명 사용.
DB_URL=jdbc:postgresql://localhost:5432/magicjar
DB_USER=magicjar
DB_PASSWORD=magicjar
# 레거시 호환 (Spring Boot autoconfig)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/magicjar
SPRING_DATASOURCE_USERNAME=magicjar
SPRING_DATASOURCE_PASSWORD=magicjar

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ─── Kafka (P4 신규) ───
# IDE bootRun: localhost:9092 (compose infra 모드의 EXTERNAL listener)
# 컨테이너 간: kafka:9092 (compose 자동 주입)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=magicjar-local

# ─── MinIO (P4 신규) ───
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=magicjar
MINIO_SECRET_KEY=magicjar123
MINIO_BUCKET=magicjar

# ─── pyworker (P4 신규) ───
PYWORKER_URL=http://localhost:8000

# ─── 전자공시 / 뉴스 (P4 신규) ───
# DART OpenAPI (https://opendart.fss.or.kr) — pyworker.scrapers.dart에서 사용
OPENDART_API_KEY=
DART_API_KEY=                                  # 레거시 키 이름 호환
# 네이버 금융 뉴스 RSS — pyworker.scrapers.naver_news에서 사용
NAVER_NEWS_RSS_URL=

# ─── 프론트엔드 (개발 시) ───
# API base URL을 vite dev에서 override할 때 사용
VITE_API_BASE_URL=http://localhost:8080
