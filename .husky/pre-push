#!/usr/bin/env sh
# magicJar pre-push — ADR 0031 (브랜칭·push 정책) · ADR 0036 (task 파일 시스템)
# (구 번호 체계 0009·0010·0015·0049 참조는 2026-07-03 감사 P2-⑨로 현행 체계 치환 — 로직 무변경)

set -e

# 0) 현재 브랜치
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# 1) 실제 push ref 변경 파일 진단 + main / release/* 직접 push 차단
#    pre-push stdin의 remote_sha..local_sha를 권위로 사용한다. checked-out HEAD/upstream은 다른 ref push 시 권위가 아니다.
ZERO="0000000000000000000000000000000000000000"
CHANGED_FILES=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "✗ pre-push: main 브랜치 직접 푸시는 금지입니다 (ADR 0031)."
      echo "  ↳ agent/*/* 또는 chore|docs|hotfix/* 브랜치에서 PR을 만들어 주세요."
      exit 1
      ;;
    refs/heads/release/*)
      # 신규 ref 생성(remote_sha = 0000…)은 베이스라인 컷이라 허용.
      # 이미 존재하는 release/* ref에 대한 update/delete만 차단 = immutable 보존.
      if [ "$remote_sha" = "$ZERO" ]; then
        echo "ℹ pre-push: release/* 신규 베이스라인 push 허용 (ADR 0031)."
      else
        echo "✗ pre-push: release/* 브랜치는 immutable(체크아웃 전용)입니다 (ADR 0031)."
        echo "  ↳ 기존 release/* (v0·v1 …) 영구 베이스라인 백업 — update·delete 금지."
        echo "  ↳ 살 붙이기·버그 수정은 main 트렁크에서 진행하세요."
        exit 1
      fi
      ;;
  esac

  # ref 삭제는 원격에 새 코드가 유입되지 않으므로 변경 파일 검증 대상이 아니다.
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    REMOTE_NAME="${1:-origin}"
    REMOTE_MAIN_REF="refs/remotes/$REMOTE_NAME/main"
    if ! git rev-parse --verify --quiet "$REMOTE_MAIN_REF" >/dev/null; then
      echo "✗ pre-push: 신규 ref 비교 기준 '$REMOTE_MAIN_REF'을 확인할 수 없습니다."
      exit 1
    fi
    if ! BASE_SHA="$(git merge-base "$local_sha" "$REMOTE_MAIN_REF")"; then
      echo "✗ pre-push: 신규 ref와 '$REMOTE_MAIN_REF'의 merge-base 계산에 실패했습니다."
      exit 1
    fi
  else
    BASE_SHA="$remote_sha"
  fi

  if ! REF_CHANGED_FILES="$(git diff --name-only "$BASE_SHA..$local_sha")"; then
    echo "✗ pre-push: '$remote_ref' 변경 파일 계산에 실패했습니다."
    exit 1
  fi
  CHANGED_FILES="$(printf '%s\n%s\n' "$CHANGED_FILES" "$REF_CHANGED_FILES")"
done

# 2) 브랜치명 규칙 경고 (실패시키진 않음)
case "$BRANCH" in
  main|agent/*/*|chore/*|docs/*|hotfix/*) ;;
  *)
    echo "⚠ pre-push: 브랜치명이 규약을 벗어납니다 — '$BRANCH'"
    echo "  권장: agent/<agent>/<task> | chore/<slug> | docs/<slug> | hotfix/<slug>"
    ;;
esac

# 3) Architecture fitness + 현행 문서 drift + task metadata 회귀 차단
echo "→ architecture fitness"
node scripts/verify-architecture-fitness.mjs || {
  echo "✗ pre-push: architecture fitness 실패."
  exit 1
}
node scripts/verify-docs-current.mjs || {
  echo "✗ pre-push: current documentation drift guard 실패."
  exit 1
}
node scripts/check-task-hygiene.mjs || {
  echo "✗ pre-push: task metadata/duplicate invariant 실패."
  exit 1
}

# 3-0-1) 자본 경로 운영 스크립트 변경 시 전용 behavior test
AUTOPILOT_SEED_CHANGED="$(printf '%s\n' "$CHANGED_FILES" | grep -E '^scripts/(autopilot-seed-strategies\.mjs|__tests__/autopilot-seed-strategies\.test\.mjs)$' || true)"
if [ -n "$AUTOPILOT_SEED_CHANGED" ]; then
  echo "→ autopilot seed fail-closed behavior tests"
  node --test scripts/__tests__/autopilot-seed-strategies.test.mjs || {
    echo "✗ pre-push: autopilot seed behavior test 실패."
    exit 1
  }
fi

# 3-1) Gradle check — wrapper script + jar 모두 있으면 실행, 없으면 skip
if [ -x ./gradlew ] && [ -f gradle/wrapper/gradle-wrapper.jar ]; then
  echo "→ ./gradlew check"
  ./gradlew check -q --daemon || {
    echo "✗ pre-push: ./gradlew check 실패."
    exit 1
  }
else
  echo "ℹ pre-push: Gradle wrapper 부재(script 또는 wrapper jar) — JVM 모듈 부트스트랩 후 활성화."
fi

# 3-2) frontend 변경 시 pnpm test + typecheck + build
#      GitHub Actions 미사용(.github/workflows 없음) — frontend 검증도 pre-push 단독 책임 (CLAUDE.md CI/CD).
FRONTEND_CHANGED="$(printf '%s\n' "$CHANGED_FILES" | grep -E '^frontend/' || true)"
if [ -n "$FRONTEND_CHANGED" ] && [ -d frontend ] && [ -f frontend/package.json ]; then
  if command -v pnpm >/dev/null 2>&1 || command -v corepack >/dev/null 2>&1; then
    echo "→ frontend pnpm test + typecheck + build (변경된 frontend/* 감지)"
    (
      cd frontend || exit 1
      EXPECTED_NODE="$(tr -d '[:space:]' < .node-version)"
      ACTUAL_NODE="$(node -p 'process.versions.node')"
      if [ "$ACTUAL_NODE" != "$EXPECTED_NODE" ]; then
        echo "✗ pre-push: frontend Node $EXPECTED_NODE 필요, 현재 $ACTUAL_NODE."
        exit 1
      fi

      if command -v pnpm >/dev/null 2>&1; then
        run_pnpm() { pnpm "$@"; }
      else
        run_pnpm() { corepack pnpm "$@"; }
      fi
      run_pnpm install --frozen-lockfile --silent && \
      run_pnpm test && \
      run_pnpm typecheck && \
      run_pnpm build
    ) || {
      echo "✗ pre-push: frontend test/typecheck/build 실패."
      exit 1
    }
  else
    echo "✗ pre-push: pnpm/corepack 미설치 — frontend 검증을 실행할 수 없습니다."
    exit 1
  fi
fi

# 4) agent/* 브랜치는 task 파일 존재 권고 (ADR 0036)
case "$BRANCH" in
  agent/*/*)
    if ! ls _workspace/tasks/*.md > /dev/null 2>&1; then
      echo "⚠ pre-push: 활성 task 파일이 없습니다 (ADR 0036)."
      echo "  ↳ node scripts/task.mjs start --agent <a> --goal \"...\" 으로 등록하세요."
    fi
    ;;
esac

exit 0
