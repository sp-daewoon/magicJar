{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magicjar.local/schemas/analysis-result.v1.json",
  "title": "AnalysisResult",
  "description": "AI 분석 보조 응답 (T16, ADR 0046). 분석 보조용 — 매매 결정 X.",
  "type": "object",
  "required": [
    "text",
    "confidence",
    "model",
    "promptVersion",
    "tokensUsed",
    "costEstimate",
    "durationMs",
    "generatedAt",
    "cached",
    "provider"
  ],
  "properties": {
    "text": {
      "type": "string",
      "description": "한국어 자연어 본문. 마지막 줄에 면책 문구 포함.",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "응답 신뢰도. 어댑터 기본값 0.6 (anthropic), 0.0 (mock)."
    },
    "model": {
      "type": "string",
      "examples": ["claude-sonnet-4-5", "mock"]
    },
    "promptVersion": {
      "type": "string",
      "examples": ["v1"]
    },
    "tokensUsed": {
      "type": "object",
      "required": ["input", "output", "total"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "costEstimate": {
      "type": "number",
      "minimum": 0.0,
      "description": "USD 추정 비용. mock = 0."
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC."
    },
    "cached": {
      "type": "boolean",
      "description": "캐시 hit (post-MVP). 현재는 항상 false."
    },
    "provider": {
      "type": "string",
      "enum": ["anthropic", "mock", "gemini", "openai", "unavailable"]
    }
  }
}
