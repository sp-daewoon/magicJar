{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewsSentimentBatch",
  "description": "SentimentAnalyzer 다건 응답 스키마(application service). 종목별 점수 + 이벤트 태그 + 매매 시그널 힌트.",
  "type": "object",
  "required": ["overallSentiment", "score", "perInstrument", "eventTags", "tradingHint", "summary", "confidence", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "overallSentiment": { "type": "string", "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"] },
    "score": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
    "perInstrument": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "sentiment", "score"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "sentiment": { "type": "string", "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"] },
          "score": { "type": "number", "minimum": -1.0, "maximum": 1.0 }
        }
      }
    },
    "eventTags": {
      "type": "array",
      "items": { "type": "string", "examples": ["earnings", "merger", "regulation", "rumor", "guidance"] }
    },
    "tradingHint": { "type": "string", "enum": ["BUY_BIAS", "SELL_BIAS", "NONE"] },
    "summary": { "type": "string", "maxLength": 120 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "reasoning": { "type": "string", "maxLength": 300 }
  }
}
