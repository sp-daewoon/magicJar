{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NewsSentimentSingle",
  "description": "AnthropicNewsSentimentAnalyzer 단건 응답 스키마. LLM이 이 형식만 반환해야 한다.",
  "type": "object",
  "required": ["sentiment", "confidence", "rationale"],
  "additionalProperties": false,
  "properties": {
    "sentiment": {
      "type": "string",
      "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"],
      "description": "단기(1-5영업일) 시장 영향 분류"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "LLM 자체 신뢰도. 추측·루머는 0.0에 수렴"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "한국어 1~2문장. 본문 근거 인용. 없으면 confidence=0.0"
    }
  }
}
