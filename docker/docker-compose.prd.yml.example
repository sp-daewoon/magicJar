# magicJar 운영 (prd) 모드 override — 사용자 직접 발급 후 docker-compose.prd.yml로 복사 + .env 추가.
# 사용:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.prd.yml up -d
#
# 주의:
# - MAGICJAR_KIS_MODE는 폐기 — SPRING_PROFILES_ACTIVE만 사용 (1번 트랙 T19).
# - prd profile 활성 시 KillSwitch는 default ON. 사용자가 명시적으로 OFF 전환.
# - REAL_KIS 모드 진입은 user_trading_config의 trading_mode를 SQL로 변경 (운영 가이드 §4).
# - 본 example 파일은 git tracked, 실 docker-compose.prd.yml은 .gitignore (실전 IP·키 노출 방지).

name: magicjar

services:
  api-app:
    environment:
      SPRING_PROFILES_ACTIVE: prd
      LOGGING_LEVEL_COM_MJ: INFO

  batch-app:
    environment:
      SPRING_PROFILES_ACTIVE: prd

  consumer-app:
    environment:
      SPRING_PROFILES_ACTIVE: prd
      LOGGING_LEVEL_COM_MJ: INFO

  frontend:
    environment:
      VITE_MODE: production

  pyworker:
    environment:
      PYWORKER_ENV: prd
